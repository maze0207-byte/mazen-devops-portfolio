# ── Terminal WebSocket (browser) ─────────────────────────────
# Full URL (production / ingress). Omit on NodePort-only access.
# NEXT_PUBLIC_WS_URL=wss://your-domain.example/ws/terminal

# NodePort: auto-detect ws://<same-host>:30400 when NEXT_PUBLIC_WS_URL is unset or localhost
NEXT_PUBLIC_TERMINAL_WS_PORT=30400

# Ingress path mode (future): wss://host/ws/terminal
# NEXT_PUBLIC_WS_PATH=/ws/terminal

# ── Terminal server (backend pod) ───────────────────────────
# HOST=0.0.0.0
# PORT=4000
# ALLOWED_ORIGINS=http://NODE_IP:30080,https://your-domain.example
# KUBECONFIG=/kubeconfig
# MAX_SESSIONS=5
# SESSION_TIMEOUT_MINUTES=10
